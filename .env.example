#
# DEVELOPMENT
#

# Docker dev container user mapping
# Set these to your host user's UID/GID to avoid file permission issues.
# Find them with: id -u && id -g
LOCAL_USER_ID=1000
LOCAL_GROUP_ID=1000

# Local SSH key path. Key won't be copied into the image,
# but will be copied into container by using docker secrets
LOCAL_SSH_KEY_PATH=[path to your ssh key]

# Git info
GIT_NAME="Build Machine"
GIT_EMAIL="info@4apps.lv"
